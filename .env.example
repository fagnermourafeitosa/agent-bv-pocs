# ==============================================================================
# Ambiente de Configuração de Variáveis - Banco BV Agents & Skills
# ==============================================================================

# Credenciais do Provedor de LLM (Google Gemini)
# Obtenha sua chave de API de desenvolvimento no Google AI Studio
GOOGLE_API_KEY="insira_seu_google_api_key_aqui"
GEMINI_MODEL="gemini-3.1-flash-lite"

# Credenciais e Endereços do Langfuse (Observabilidade e Tracing de LLMs)
# NOTA: No ambiente de desenvolvimento local (Docker Compose), você pode gerar estas chaves
# no painel administrativo do Langfuse (http://localhost:3000) e inseri-las abaixo.
LANGFUSE_SECRET_KEY="insira_sua_langfuse_secret_key_aqui"
LANGFUSE_PUBLIC_KEY="insira_sua_langfuse_public_key_aqui"
LANGFUSE_HOST="http://localhost:3000"
